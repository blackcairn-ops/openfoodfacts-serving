# syntax=docker/dockerfile:1
# Multi-stage build: CGO is required for the duckdb-go/v2 driver.
# Build stage uses Go bookworm (glibc); runtime is debian-slim (same glibc).
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY *.go ./
RUN CGO_ENABLED=1 go build -ldflags "-s -w" -o /foodfacts .

FROM debian:bookworm-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /foodfacts /usr/local/bin/foodfacts
EXPOSE 8080
ENTRYPOINT ["foodfacts"]
CMD ["serve"]
